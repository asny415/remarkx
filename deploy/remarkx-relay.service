[Unit]
Description=remarkx relay — X 阅读器中转站（抓取/缓存/排版渲染）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wwq
WorkingDirectory=/home/wwq/code/remarkx/relay
ExecStart=/home/wwq/code/remarkx/.venv/bin/python /home/wwq/code/remarkx/relay/relay.py run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
